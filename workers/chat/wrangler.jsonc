{
  // Deploys to the `demo` ns (regular tenant ns, user-runtime, public-only
  // outbound). The MicroVM broker (sandbox-broker) is reached via the BROKER
  // JSRPC service binding below.
  "name": "chat-worker",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-31",

  "durable_objects": {
    "bindings": [
      { "name": "CHAT_SESSION_DO", "class_name": "ChatSessionDO" }
    ]
  },

  // wdl-cli accepts new_classes; do-runtime forces SQLite-backed storage
  // regardless (host actor's enableSql=true).
  "migrations": [
    { "tag": "v1", "new_classes": ["ChatSessionDO"] }
  ],

  "d1_databases": [
    {
      "binding": "CHAT_DB",
      "database_name": "chat-db",
      "migrations_dir": "migrations"
    }
  ],

  "workflows": [
    { "name": "chat-run", "binding": "CHAT_RUN", "class_name": "ChatRunWorkflow" }
  ],

  // JSRPC binding to the MicroVM lifecycle broker (open / mint / close). The
  // broker holds the AWS key; chat-worker only invokes these methods + talks
  // to the MicroVM endpoint directly with the short-lived JWE it returns.
  "services": [
    { "binding": "BROKER", "service": "sandbox-broker", "entrypoint": "Broker" }
  ],

  // PLATFORM_DOMAIN builds deploy previewUrl = https://<ns>.<PLATFORM_DOMAIN>/app/
  "vars": {
    "PLATFORM_DOMAIN": "wdl.sh"
  }

  // secrets via `wdl secret put --worker chat-worker --ns demo`:
  //   TOKEN_ISSUER_TOKEN     - narrow token-issuer credential; mints per-session
  //                            tmp ns tokens via /auth/delegated-tokens
  //   OPERATOR_TOKEN         - operator endpoints (/admin/*)
  //   LLM_API_KEY            - DeepSeek key (anthropic-compatible API)
  //   ADMIN_URL              - https://api.wdl.dev
  //   DEMO_PASSCODE          - gates POST /portal/start (the portal login)
}
